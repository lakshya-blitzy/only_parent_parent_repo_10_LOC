<Project>

    <!--
        The single source of truth for target framework, language level, and build-quality policy.
        Every project in this repository inherits these properties; package versions live in
        Directory.Packages.props and the SDK is pinned in global.json.
    -->
    <PropertyGroup>
        <!-- The ONLY TargetFramework declaration in this repository.
             Changing .NET versions is a one-line change here. -->
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>12.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- Quality gate: any warning is a build failure. -->
        <AnalysisLevel>latest-Recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <!-- ContinuousIntegrationBuild normalizes the source paths embedded in assemblies and PDBs.
         That makes output reproducible but breaks local debugging, so it is enabled only when the
         CI environment variable is set to true. -->
    <PropertyGroup Condition="'$(CI)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

</Project>
