<Project>

    <!--
        NuGet Central Package Management: package versions are declared here and nowhere else, so a
        project cites a package by name only and versions cannot drift between projects.

        CPM emits NU1507 when more than one package source is configured, and Directory.Build.props
        makes warnings fatal. This repository resolves against a single source (nuget.org); if a
        second one ever becomes necessary, the remedy is NuGet package source mapping rather than
        relaxing the warning gate.
    -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- Test-only packages: the production projects declare no PackageReference at all. Each entry
         is an exact pin, never a floating range or wildcard; transitive dependencies are resolved
         by NuGet from these roots rather than pinned here. -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    </ItemGroup>

</Project>
