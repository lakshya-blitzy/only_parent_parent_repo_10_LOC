; npm configuration for this repository.
;
; This project is intentionally dependency-free: package.json declares
; neither "dependencies" nor "devDependencies", so there is nothing to lock.
; Disabling lockfile generation stops `npm install` from writing an untracked
; package-lock.json, which would dirty the working tree and break the
; "clean tree after a full build/test cycle" quality gate.
package-lock=false
