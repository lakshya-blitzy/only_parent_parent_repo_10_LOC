# EditorConfig - https://editorconfig.org
# root = true stops the lookup here, so no .editorconfig above this repository leaks settings
# into the build.
root = true

# ---------------------------------------------------------------------------------------------
# How this file is enforced
# ---------------------------------------------------------------------------------------------
# Directory.Build.props switches on EnforceCodeStyleInBuild, which promotes the C# style rules
# below into the compiler as IDExxxx diagnostics, and TreatWarningsAsErrors together with
# CodeAnalysisTreatWarningsAsErrors, which makes any surviving diagnostic a build failure. Every
# severity written below is therefore a decision about what breaks the build.
#
# Two policies are declared here and nowhere else:
#   1. Formatting - character encoding, line endings, and indentation for every file type.
#   2. C# style  - file-scoped namespaces, using-directive placement, required braces, and
#                  explicit accessibility modifiers.
#
# The single diagnostic suppression in this repository also lives here, in the last section,
# scoped by path and explained in place. Suppressions belong in this file - visible, commented,
# and narrow - never in a project file.

# ---------------------------------------------------------------------------------------------
# Every file
# ---------------------------------------------------------------------------------------------
# UTF-8 with line-feed endings is the repository-wide baseline. A final newline plus trimmed
# trailing whitespace keeps diffs minimal and stops tools from reporting phantom last-line
# changes.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# ---------------------------------------------------------------------------------------------
# C# source and MSBuild project/solution files - four-space indentation
# ---------------------------------------------------------------------------------------------
# Four spaces is the .NET convention. The project-system files are grouped with the code they
# build so that both read consistently.
[*.{cs,csproj,props,sln}]
indent_size = 4

# ---------------------------------------------------------------------------------------------
# Data, workflow, and documentation files - two-space indentation
# ---------------------------------------------------------------------------------------------
# Two spaces suits the nesting-heavy formats, where JSON and YAML in particular carry structure
# through indentation.
[*.{json,yml,yaml,md}]
indent_size = 2

# ---------------------------------------------------------------------------------------------
# C# style rules
# ---------------------------------------------------------------------------------------------
# Severity legend:
#   warning - fatal, because TreatWarningsAsErrors is on. Reserved for the conventions every C#
#             file in this repository satisfies.
#   silent  - the preference is available to IDE refactorings but is never reported, and so can
#             never fail a build.
#
# Each enforced convention is written twice, once per syntax, because the two forms are honoured
# by different tools:
#   * option = value:severity  - sets the preferred style. On this SDK band the ":severity"
#     suffix is respected only by IDE live analysis; the command-line compiler ignores it.
#   * dotnet_diagnostic.IDExxxx.severity - the rule-identifier form the compiler does honour, and
#     therefore the only form that turns a preference into a build failure.
# Both are kept so that editors and the build agree instead of drifting apart.
[*.cs]

# Using directives sit above the namespace declaration, System-prefixed namespaces first, in a
# single unbroken group.
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Namespaces are file-scoped - "namespace Blitzy.LegacyPort.Core;" with no braces and no extra
# indentation level. A file that declares no namespace at all is unaffected by this rule.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# Accessibility is always explicit on non-interface members, so no type or member ever relies on
# C#'s default of internal or private. Interface members are exempt, where the default is
# unambiguous.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.IDE0040.severity = warning

# Braces are required even on a single-statement body: an unbraced body is the classic place
# where a later edit silently falls outside the block.
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# Allman braces - the open brace on its own line - and indented switch sections. These are
# whitespace preferences, left at the severity the analyzer set gives them so that they guide
# editors and "dotnet format" without promoting a stray space into a build failure.
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true

# Expression-bodied members are permitted, never mandated. Recorded at silent so that neither the
# concise nor the block form is ever reported.
csharp_style_expression_bodied_methods = when_on_single_line:silent

# ---------------------------------------------------------------------------------------------
# Test tree - the only diagnostic suppression in this repository
# ---------------------------------------------------------------------------------------------
# xUnit test methods follow the universal Method_Scenario_Expectation naming convention - for
# example Greet_WithName_ReturnsExpectedGreeting - whose underscores collide with CA1707,
# "Identifiers should not contain underscores".
#
# The exemption is a path-scoped severity override here rather than a suppression property in the
# test project file, so that it stays visible in the conventions file, stays commented, and stays
# confined to the test tree. CA1707 remains fatal for everything under src/, leaving the
# zero-warning gate over production code untouched, and this is the only rule in this file that is
# switched off.
#
# The glob is coupled to the tests/ directory name: renaming that directory disables the exemption
# and makes every underscored test name a build error again, so the two must move together.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
