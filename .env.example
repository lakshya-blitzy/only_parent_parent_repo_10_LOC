# ------------------------------------------------------------------------------
# .env.example - environment-variable overrides for the /health endpoint.
#
# This is a committed EXAMPLE, and every value below is that setting's default,
# so sourcing this file as it stands changes nothing. It is the operator-facing
# reference for the environment variables that override the keys in
# app.config.properties - the single cross-language source of truth shared by
# app.py, index.js and User.java.
#
# Copy it before editing, and keep the copy out of version control:
#
#     cp .env.example .env
#
# A real .env must NEVER be committed. .gitignore lists the exact name .env, so
# the copy stays untracked while this reference file stays tracked. Put real
# values in .env, never here.
#
# Nothing loads .env automatically. This project has zero third-party
# dependencies in all three languages, so there is no dotenv library: the
# applications read the real process environment and nothing else. Inject these
# values yourself, whichever way suits:
#
#     set -a; . ./.env; set +a        # POSIX shell: export every assignment
#     docker run --env-file .env ...  # container runtime
#     APP_NAME=demo python3 app.py --serve    # one variable, one process
#
# Precedence: environment variable > app.config.properties > built-in default
# PORT (if set) overrides PYTHON_PORT / NODE_PORT / JAVA_PORT.
#
# An empty value counts as absent at every level in all three implementations,
# so APP_NAME= falls through to app.config.properties instead of reporting an
# empty name, which the response contract forbids.
#
# These settings apply to --serve and --probe only. The default invocation of
# each application reads no configuration at all and behaves exactly as it
# always has, so nothing set here can change existing behaviour.
# ------------------------------------------------------------------------------

# --- Application identity -----------------------------------------------------

# Overrides app.name. Reported verbatim as the "name" field of the health
# payload, so it must be non-empty.
APP_NAME=only_parent_parent_repo_10_LOC

# Overrides app.version. Reported verbatim as the "version" field, in
# three-part dotted form. Keep it in step with app.config.properties,
# pyproject.toml, package.json and README.md: the CI version-consistency gate
# fails the build when those disagree.
APP_VERSION=1.1.0

# --- Endpoint and binding -----------------------------------------------------

# Overrides health.path. The one route the endpoint answers; every other path
# returns 404. Give it with a leading slash - a value without one is normalised
# to have one.
HEALTH_PATH=/health

# Overrides app.host. Bind address used in --serve mode. The wildcard is
# deliberate: a container health probe or an orchestrator cannot reach a
# listener bound to loopback. Set 127.0.0.1 to restrict access to this host.
APP_HOST=0.0.0.0

# --- Listener ports -----------------------------------------------------------
# One default per language, so all three servers can run at the same time on
# one host without a bind collision. Use a whole number in 0-65535; 0 asks the
# operating system for an ephemeral port.
#
# An unusable value is never guessed at silently. All three implementations fail
# closed in exactly the same way: they name the offending value on stderr and
# exit 1 without serving, rather than substituting a different port. That is
# deliberate - a mistyped port that quietly became the default would leave a
# healthy-looking process listening somewhere nobody is watching, with every
# probe aimed at the port you asked for reporting nothing there. Note also that
# the accepted grammar is a plain decimal integer in all three, so 0x50 is
# refused rather than read as 80.

# Overrides python.port. Used by app.py only.
PYTHON_PORT=8000

# Overrides node.port. Used by index.js only.
NODE_PORT=8001

# Overrides java.port. Used by User.java only.
JAVA_PORT=8002

# PORT is the universal listener port and outranks every other source,
# including PYTHON_PORT, NODE_PORT, JAVA_PORT and the properties file. It
# follows the twelve-factor convention for one application per container, where
# the platform injects PORT and knows nothing about this project's per-language
# keys.
#
# It is deliberately left commented out, because this file is meant to be
# sourced whole: an active PORT would point all three applications at the same
# port, and the second and third to start would fail to bind. Set it for a
# single process instead:
#
#     PORT=8080 python3 app.py --serve
#
# Unset by default, which is what lets the three per-language ports above take
# effect.
#PORT=8080
