# Example environment overrides for the /health endpoint. Copy to .env, edit the copy, and never commit
# real values; .gitignore lists the exact name .env so this reference file stays tracked.
# Precedence: environment variable > app.config.properties > built-in default.
# Every value below is that setting's default.
# These settings apply to --serve and --probe only; the default invocation reads no configuration.

# --- Application identity ---
# These two are published verbatim in the /health body AND are what --probe requires the answer to
# carry. A self-check that graded only the document's SHAPE would be satisfied by any other
# application serving a conforming document on the same loopback port, and would report this one up
# while it was down; so an answer whose name or version differs from these values, or that is not
# served as application/json, is refused with exit 1 and one line on stderr.
#
# Length budget. --probe reads at most 8192 bytes and refuses a larger answer, which is the bound
# that stops an endpoint streaming without end. The rendered body is 73 + APP_NAME + APP_VERSION
# bytes of UTF-8 (73 = the four keys, the punctuation, the 20-character instant and the status), so
# the two together must stay under 8119 bytes - with the version below, an APP_NAME up to 8114
# bytes. Measured: 8114 gives a body of exactly 8192 and probes healthy, 8115 gives 8193 and is
# refused. The count is BYTES, not characters: a four-byte emoji spends four of them. Past the
# budget the probe fails closed against a HEALTHY server, so a container HEALTHCHECK reading its
# exit status restarts a working container. Identical in all three implementations.

# Overrides app.name. Reported verbatim as the "name" field, so it must be non-empty.
APP_NAME=only_parent_parent_repo_10_LOC

# Overrides app.version. Reported verbatim as the "version" field, in three-part dotted form.
APP_VERSION=1.1.0

# --- Endpoint and binding ---

# Overrides health.path. The single route served; a missing leading slash is added, a leading // refused.
HEALTH_PATH=/health

# Overrides app.host. Bind address in --serve mode; use 127.0.0.1 to restrict access to this host.
APP_HOST=0.0.0.0

# --- Listener ports ---
# A whole number in 0-65535; 0 asks the operating system for an ephemeral port. An unusable value is
# always refused and never silently replaced with a different port, and the two modes report it
# differently on purpose: --serve names the value, because an operator is at the terminal and typed
# it, while --probe reports only the category "the configured port is unusable", because it runs
# unattended on a container health-check timer where the value would be an input copied into a log.
# Both write exactly one line to stderr, nothing to stdout, and exit 1.

# Overrides python.port. Used by app.py only.
PYTHON_PORT=8000

# Overrides node.port. Used by index.js only.
NODE_PORT=8001

# Overrides java.port. Used by User.java only.
JAVA_PORT=8002

# PORT outranks every other source, including the three variables above. It is left commented out
# because this file is meant to be sourced whole: an active PORT would aim all three applications at
# the same port and the second to start would fail to bind. Set it for one process instead.
#PORT=8080
