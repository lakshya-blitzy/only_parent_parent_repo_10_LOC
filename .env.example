# Example environment overrides for the /health endpoint. Copy to .env, edit the copy, and never commit
# real values; .gitignore lists the exact name .env so this reference file stays tracked.
# Precedence: environment variable > app.config.properties > built-in default.
# Every value below is that setting's default.
# These settings apply to --serve and --probe only; the default invocation reads no configuration.

# --- Application identity ---

# Overrides app.name. Reported verbatim as the "name" field, so it must be non-empty.
APP_NAME=only_parent_parent_repo_10_LOC

# Overrides app.version. Reported verbatim as the "version" field, in three-part dotted form.
APP_VERSION=1.1.0

# --- Endpoint and binding ---

# Overrides health.path. The single route served; a missing leading slash is added, a leading // refused.
HEALTH_PATH=/health

# Overrides app.host. Bind address in --serve mode; use 127.0.0.1 to restrict access to this host.
APP_HOST=0.0.0.0

# --- Listener ports ---
# A whole number in 0-65535; 0 asks the operating system for an ephemeral port. An unusable value is
# named on stderr and refused, never silently replaced with a different port.

# Overrides python.port. Used by app.py only.
PYTHON_PORT=8000

# Overrides node.port. Used by index.js only.
NODE_PORT=8001

# Overrides java.port. Used by User.java only.
JAVA_PORT=8002

# PORT outranks every other source, including the three variables above. It is left commented out
# because this file is meant to be sourced whole: an active PORT would aim all three applications at
# the same port and the second to start would fail to bind. Set it for one process instead.
#PORT=8080
