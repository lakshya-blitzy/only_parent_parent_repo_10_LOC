# Source hygiene for the .NET 8 solution in this repository: generated build output and
# per-developer editor state only. Every hand-authored file stays tracked, so never add a broad
# pattern such as *.json, *.props, *.sln, *.yml, *.config or .* - each would hide one of them.

# Build output. MSBuild writes each project to bin/<Configuration>/net8.0/ and keeps its
# intermediate output, including the NuGet restore assets, under obj/.
bin/
obj/

# Test and coverage output, whether written to a results directory or beside the test project.
artifacts/
[Tt]est[Rr]esults/
*.trx
[Cc]overage*/
*.coverage
*.coverlet.json

# IDE and editor state. Per-developer, machine-specific, never shared.
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.DotSettings.user

# NuGet package output. Nothing in this repository is packed for publication, so any
# package file present locally is a build by-product.
*.nupkg
*.snupkg

# Operating-system and editor scratch files.
.DS_Store
Thumbs.db
