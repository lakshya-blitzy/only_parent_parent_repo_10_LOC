# Python bytecode
__pycache__/
*.pyc

# Java build output
*.class
classes/

# Node dependencies. With zero declared dependencies a lockfile records nothing,
# yet `npm install` writes one and would otherwise dirty the working tree.
node_modules/
package-lock.json
npm-shrinkwrap.json

# Test cache
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local environment overrides - exact names, so the committed .env.example stays tracked
.env
.env.local

# Local tooling output
blitzy/
